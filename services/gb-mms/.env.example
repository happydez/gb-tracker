# Copy to .env and fill in. Compose reads it from this directory.
# Only needed for the steps that are enabled in gbmms.yaml.

# ftp.enabled
GB_FTP_USER=
GB_FTP_PASSWORD=

# rcon.enabled
GB_RCON_PASSWORD=

# The containers write to ./data as this uid/gid. Set it to your own
# (id -u && id -g), or the database ends up owned by someone you are not.
GB_UID=1001
GB_GID=1001