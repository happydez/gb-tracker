# Discord webhook urls for the notifier

# Announcements about new and updated mods.
GB_DISCORD_WEBHOOK_PUBLIC=https://discord.com/api/webhooks/000000000000000000/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Failures reported by the services. Point it at a channel only you can see.
GB_DISCORD_WEBHOOK_PRIVATE=https://discord.com/api/webhooks/000000000000000000/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The containers write to ./data as this uid/gid. Set it to your own
# (id -u && id -g), or the database ends up owned by someone you are not.
GB_UID=1001
GB_GID=1001